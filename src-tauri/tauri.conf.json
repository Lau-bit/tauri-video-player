{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Player",
  "version": "1.0.0",
  "identifier": "com.slaur.video-player",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Video Player",
        "width": 1280,
        "height": 817,
        "minWidth": 320,
        "minHeight": 240,
        "decorations": false,
        "backgroundColor": "#0a0a0a",
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' asset: http://asset.localhost blob:; img-src 'self' data: asset: http://asset.localhost blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
